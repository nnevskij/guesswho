# Railway imposta PORT da solo
PORT=3001
# Origini del client Next.js separate da virgola (in produzione NON lasciare *)
CLIENT_ORIGIN=http://localhost:3000,https://giochiloschi.com,https://www.giochiloschi.com
MIN_PLAYERS=2
MAX_PLAYERS=20
# Dopo quanti ms un giocatore disconnesso viene rimosso (default 5 minuti)
DISCONNECT_GRACE_MS=300000
# Durata massima di una stanza (default 12 ore)
ROOM_TTL_MS=43200000
ROOM_CODE_LENGTH=5
RATE_LIMIT_PER_SEC=20
# Conto alla rovescia prima della lista personaggi e durata della lista (ms)
REVEAL_COUNTDOWN_MS=5000
REVEAL_DURATION_MS=30000

# Nomi falsi aggiunti di default alla lista (0-3)
DEFAULT_DECOYS=2
